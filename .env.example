# Pensieve ML — Environment Variables Configuration
# Copy to .env and provide your API credentials.
# NEVER commit .env with real credentials.

# Language Model Provider Key for Phase 5 Grounded Reflection Generation
# Can be either REFLECTION_API_KEY or OPENAI_API_KEY
REFLECTION_API_KEY=
OPENAI_API_KEY=

# Backend Application Settings
ENVIRONMENT=development
DATABASE_URL=sqlite:///./pensieve.db
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
